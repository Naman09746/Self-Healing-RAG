# API Settings
PROJECT_NAME="Self-Healing RAG Pipeline"

# Security Settings — RS256 (generate with: python -c "from backend.core.security import generate_rsa_keypair; print(generate_rsa_keypair())")
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ENV=development

# LLM Settings (ollama for local, openrouter/openai/groq for prod)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3.2:1b
SMALL_MODEL_NAME=llama3.2:1b

# ── Embedding Settings — powerful upgrades (see backend/storage/vector/embeddings.py MODEL_DIM_REGISTRY) ──
# Provider: auto | ollama | openai | hf (sentence-transformers)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=nomic-embed-text
# Examples — pick ONE powerful upgrade:
#   Ollama local (no API cost, add `ollama pull qwen3-embedding:0.6b`):  EMBEDDING_MODEL=qwen3-embedding:0.6b  VECTOR_STORE_DIM=1024
#   Ollama Qwen 8B (GPU, SOTA 70.3 MTEB):                                 EMBEDDING_MODEL=qwen3-embedding:8b   VECTOR_STORE_DIM=4096
#   HF local Qwen3 (600M, beats OpenAI large, needs HF download):        EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B  EMBEDDING_PROVIDER=hf  VECTOR_STORE_DIM=1024
#   HF local BGE-M3 (multilingual, 8192 ctx, versatile):                  EMBEDDING_MODEL=BAAI/bge-m3              EMBEDDING_PROVIDER=hf  VECTOR_STORE_DIM=1024
#   HF local Jina v3 (8192 ctx, late chunking):                           EMBEDDING_MODEL=jinaai/jina-embeddings-v3 EMBEDDING_PROVIDER=hf VECTOR_STORE_DIM=1024
#   OpenAI large (3072d, 64.6 MTEB):                                       EMBEDDING_MODEL=text-embedding-3-large   VECTOR_STORE_DIM=3072
#   Prod OpenRouter (current):                                              EMBEDDING_MODEL=openai/text-embedding-3-small VECTOR_STORE_DIM=1536
# For prod OpenRouter: EMBEDDING_MODEL=openai/text-embedding-3-small and VECTOR_STORE_DIM=1536
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# Vector Store Settings (pluggable: pgvector | qdrant | pinecone)
VECTOR_STORE_PROVIDER=pgvector
VECTOR_STORE_DIM=768
# Prod (OpenRouter): VECTOR_STORE_DIM=1536 — migration 006 alters pgvector automatically
# 10k+ Scale: halfvec + filtered HNSW + enable_seqscan (see below)
PGVECTOR_USE_HALFVEC=false
PGVECTOR_FILTERED_INDEX_TENANT=
PGVECTOR_ENABLE_SEQSCAN_OFF=false
PGVECTOR_EF_SEARCH=40
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_collection
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-collection

# Session Store Settings (free-tier: pg uses Postgres, no extra container)
SESSION_STORE_PROVIDER=pg
SESSION_TTL=3600

# Sparse Store Settings (free-tier: pg_tsvector uses Postgres)
SPARSE_PROVIDER=pg_tsvector

# Reranker Settings (free-tier: none saves 80MB; enable for +12-15% NDCG)
# Recommended powerful upgrades:
#   BAAI/bge-reranker-v2-m3      (multilingual, 568M, best balance)
#   Qwen/Qwen3-Reranker-0.6B     (Qwen family, matches Qwen embeddings)
#   cross-encoder/ms-marco-MiniLM-L-12-v2 (stronger than L-6, but slower)
#   mixedbread-ai/mxbai-rerank-large-v1
RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Example powerful: RERANKER_PROVIDER=cross-encoder  RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Graph Store Settings (free-tier: memory, no Neo4j container)
GRAPH_PROVIDER=memory
NEO4J_ENABLED=false
GRAPH_EXTRACTION_ENABLED=false

# Embedding Hardening (Phase 0.3) — False in production to fail-closed on embedding errors
EMBEDDING_STRICT_DIM=true
EMBEDDING_FALLBACK_ENABLED=true
# In production (Render ENV=production): EMBEDDING_FALLBACK_ENABLED=false — hash fallback poisons index

# RAG Thresholds & Retrieval Tuning (Phase 3 calibrated)
RELEVANCE_THRESHOLD=0.5
GROUNDING_THRESHOLD=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MULTI_QUERY_ENABLED=false
MULTI_QUERY_MAX_VARIANTS=3
# Explicit calibrated thresholds — separate score spaces (do NOT compare RRF 0.016 vs cross-encoder 0.5)
# Vector cosine distance 0=identical 2=opposite, lower better. Relevant: 0.22-0.41, Irrelevant: 0.83+ (after re-ingest)
VECTOR_DISTANCE_THRESHOLD=0.65
# Cross-encoder logits -5..10, higher better. Default 0.5 conservative for ms-marco; tune to 2.0 for stricter
RERANKER_THRESHOLD=0.5
# RRF fallback when reranker disabled: 1/(k+rank+1) ~0.016 rank0, 0.008 rank5
RRF_THRESHOLD=0.008
# Sparse ts_rank 0..1 (Postgres ts_rank)
SPARSE_SCORE_THRESHOLD=0.01

# Redis Settings (only when SESSION_STORE_PROVIDER=redis, e.g. Upstash free: rediss://...)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Database Settings (async — app uses asyncpg at runtime)
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/self_healing_rag
# Note: Alembic rewrites asyncpg → psycopg2 automatically, you only need this one URL.

# OpenTelemetry Tracing (Phase 4C)
# OTLP HTTP endpoint for exporting traces. Leave empty to use console exporter.
# Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Export traces to console for local development. Set False in production.
OTEL_CONSOLE_EXPORT=true

# LangSmith Observability (Phase 4C)
# API key from https://smith.langchain.com. Leave empty to disable LangSmith tracing.
LANGSMITH_API_KEY=
# Project name for grouping LangSmith runs.
LANGSMITH_PROJECT=self-healing-rag
